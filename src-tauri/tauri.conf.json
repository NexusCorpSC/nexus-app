{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus App",
  "version": "0.8.0",
  "identifier": "services.nexus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus App",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#061E30"
      },
      {
        "label": "overlay",
        "title": "Nexus - recherche rapide",
        "url": "index.html#/overlay",
        "width": 720,
        "height": 480,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "notes",
        "title": "Nexus - bloc-notes",
        "url": "index.html#/notes-overlay",
        "width": 460,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "cargo",
        "title": "Nexus - feuille de cargo",
        "url": "index.html#/cargo-overlay",
        "width": 460,
        "height": 620,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Nexus - capture d'ecran",
        "url": "index.html#/capture",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "notifications",
        "title": "Nexus - notifications",
        "url": "index.html#/notifications",
        "width": 340,
        "height": 140,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NexusCorpSC/nexus-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMDFCMjNDQzY4RTY1RjIKUldUeVpZN0dQTElCdzIydHdiMVZ3WHFUc1BPQUF1SGZQK1d5SDlGQWg2MFd5RjZTOHA1eGprTGoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Nexus Tools on the desktop",
    "longDescription": "Desktop client for Nexus Tools - blueprints, missions, reputations, inventory and organizations for Star Citizen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
