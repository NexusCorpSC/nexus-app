{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and quick-search overlay: both call the Nexus Tools API and read the persisted settings.",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://tools.services.nexus/*" },
        { "url": "http://localhost:3000/*" },
        { "url": "http://127.0.0.1:3000/*" }
      ]
    }
  ]
}
